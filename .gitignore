# Claude Code worktrees/session data
.claude/

# pp-bench results: machine-local numbers, diffed locally — never shared truth
bench-results.jsonl

# Standardized benchmark corpora: real RAWs, frozen after copy — too big
# for git, documented by the committed README beside them
test-corpora/*
!test-corpora/README.md
# Retrieval golden-query gate: the directory note is committed; the actual
# query set (real library hashes) stays out of git. (pp-retrieval-eval.)
!test-corpora/retrieval/
test-corpora/retrieval/*
!test-corpora/retrieval/README.md

# P6.3 spike: throwaway harness + GB-scale model artifacts (report goes to docs/)
spike-p6.3/

# machine-specific shared cargo target (see .cargo/config.toml.sample)
.cargo/config.toml
