{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photoproof",
  "version": "0.1.0",
  "identifier": "com.photoproof.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Photoproof",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#0e0e0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' photoproof: http://photoproof.localhost https://photoproof.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
